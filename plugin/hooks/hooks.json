{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/load-playbooks.sh\"",
            "description": "caw: 直近 office/secretary/notes と関連 Playbook をコンテキストに自動注入"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/output-location-check.sh\"",
            "description": "caw: 成果物配置の二層原則違反（office/<dept>/<旧パス>/ への書き込み）を検出して警告"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/learnings-reminder.sh\"",
            "description": "caw: 今日の活動があるのに learnings.md が無ければ作成を促す"
          }
        ]
      }
    ]
  }
}
